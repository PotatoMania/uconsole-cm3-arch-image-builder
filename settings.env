# working directory
WORKING_DIR="/tmp/image-build"

# image file name
IMAGE_NAME="test-image.img"

# full image size, in MiB
IMAGE_SIZE=4096

# swapfile size, in MiB. swapfile is used so the partition can be flexible
# swapfile location is hardcoded to /swapfile
SWAP_SIZE=1024

# config to bootstrap the rootfs(optional if on a archlinuxarm host)
# If you want to use a mirror to improve download speed, refer `resources/alarm-stage0-china-pacman.conf`
PACSTRAP_PACMAN_CONFIG=resources/alarm-stage0-global-pacman.conf

# partition setup, for MBR scheme
# type[,fs-type]:start:end:format:label:location
# for RPis, the fs-type of boot partition must be fat32(0x0c)
MBR_PARTITION_SETUP=(
    primary,fat32:16MiB:512MiB:fat32:BOOT:/boot
    primary:512MiB:100%:ext4:ROOTFS:/
)

# packages to be installed when bootstrapping
PACSTRAP_PACKAGES=(
    base
	archlinuxarm-keyring
	raspberrypi-bootloader
    firmware-raspberrypi
	linux-firmware-atheros
    linux-firmware-broadcom
    linux-firmware-cirrus
    linux-firmware-intel
    linux-firmware-mediatek
    linux-firmware-realtek
    linux-firmware-other

	wireless-regdb
	networkmanager
	vim
    nano
	sudo

    pacman-contrib
)

INSTALL_EXTRA_PACKAGES=(
    # Wireless firmware, packaged
	"pkgs/ap6256-firmware-0.1.20231120-1-any.pkg.tar.zst"
	# linux kernel
	"pkgs/linux-uconsole-rpi64-6.12.y-1-aarch64.pkg.tar.zst"
)

INSTALL_STATIC_FILES=(
    resources/paccache-clean-pre-install.hook:etc/pacman.d/hooks/paccache-clean-pre-install.hook:644
    resources/paccache-clean-post-install.hook:etc/pacman.d/hooks/paccache-clean-post-install.hook:644
    resources/paccache-clean-post-uninstall.hook:etc/pacman.d/hooks/paccache-clean-post-uninstall.hook:644

    resources/template-cmdline.txt:boot/cmdline.txt:644
    resources/template-config.txt:boot/config.txt:644
)

NEW_PRIV_USER=ucon
NEW_PRIV_USER_PASS=ucon
# wheel is automatically added nevertheless
NEW_PRIV_USER_GROUPS=(adm)
